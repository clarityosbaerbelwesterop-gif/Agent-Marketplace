# Copy this file to `.env.local` and fill in values from your own providers.
# Do not commit secrets.

# App
NEXT_PUBLIC_APP_URL=

# Database (Lakebase Postgres via Neon)
DATABASE_URL=

# Neon Auth (Managed Better Auth)
# Values come from the Neon Console: Auth → Configuration.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_NEON_AUTH_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Model routing
UNOROUTER_API_KEY=
