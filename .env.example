# Copy this file to `.env.local` and fill in values from your own providers.
# Do not commit secrets.

# App
NEXT_PUBLIC_APP_URL=

# Database (Lakebase Postgres via Neon)
# Pooled URI for the Next.js server. Role: neondb_owner (BYPASSRLS) — privileged.
DATABASE_URL=
# Direct (non-pooler) URI for drizzle-kit migrations. Same role as DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional pooled URI for a LOGIN role without BYPASSRLS. withUserRls() falls back
# to DATABASE_URL + SET LOCAL ROLE authenticated when this is empty.
DATABASE_AUTHENTICATED_URL=

# Neon Auth (Managed Better Auth)
# Values come from the Neon Console: Auth → Configuration.
# Example base URL: https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
NEXT_PUBLIC_NEON_AUTH_URL=
# JWKS used if a raw JWT must be verified (optional for cookie sessions).
# Defaults conceptually to ${NEON_AUTH_BASE_URL}/.well-known/jwks.json
NEON_AUTH_JWKS_URL=

# Stripe Checkout (official SDK). Webhook: POST /api/webhooks/stripe
# Deploy owns live keys. Empty keys → checkout/webhook APIs return 503 (no unpaid bypass).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Model routing (UnoRouter OpenAI-compatible API)
# Docs: https://unorouter.com/en/docs/platform/quickstart
# Create a key at https://unorouter.com/en/token
UNOROUTER_API_KEY=
# Optional. Default: https://api.unorouter.com/v1
UNOROUTER_BASE_URL=
# Optional same-tier model overrides. Fallbacks never cross alias tiers.
# UNOROUTER_MODEL_STANDARD=
# UNOROUTER_MODEL_STANDARD_FALLBACKS=
# UNOROUTER_MODEL_ADVANCED=
# UNOROUTER_MODEL_EXPERT=
# UNOROUTER_MODEL_ELITE=
# UNOROUTER_MODEL_FRONTIER=
# UNOROUTER_TIMEOUT_MS=
# UNOROUTER_MAX_RETRIES=
